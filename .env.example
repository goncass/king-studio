# ============================================
# KingsStudio 2020 - Environment Variables
# ============================================
# Copia este ficheiro para .env.local e preenche os valores reais
# NO COMITAR .env.local (está no .gitignore)

# --------------------------------------------
# SUPABASE (obrigatório)
# Obter em: Supabase Dashboard → Settings → API
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx

# --------------------------------------------
# RESEND - Emails transacionais (obrigatório)
# Obter em: resend.com → API Keys
# --------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=KingsStudio <agendamentos@kingsstudio.pt>
ADMIN_EMAIL=teu@email.pt

# --------------------------------------------
# AUTH & CRON (obrigatório)
# --------------------------------------------
# JWT_SECRET: qualquer string longa aleatória (mín 32 chars)
# Gerar: openssl rand -base64 32
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CRON_SECRET: string secreta para o Vercel Cron (job de lembretes 24h)
# Gerar: openssl rand -base64 32
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# OPCIONAL - Cal.com embed
# --------------------------------------------
# NEXT_PUBLIC_CAL_COM_LINK=https://cal.com/teu-usuario/kingsstudio