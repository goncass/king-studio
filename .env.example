# KingsStudio 2020 - Environment Variables
# Copy this to .env.local and fill in your values

# JWT Secret - MUST be at least 32 characters in production!
# Generate with: openssl rand -base64 32
JWT_SECRET="kingsstudio-super-secret-change-in-production-min-32-chars"

# Optional: Database URL (for future Supabase/PostgreSQL integration)
# DATABASE_URL="postgresql://user:pass@host:5432/db"

# Optional: Email service (for booking confirmations)
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="user"
# EMAIL_SERVER_PASSWORD="pass"
# EMAIL_FROM="noreply@kingsstudio.pt"

# Optional: SMS service (for booking confirmations)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=""